    {
      "id": "38a6ce8b",
      "key": "quality",
      "audience": "customer",
      "kind": "text",
      "numbered": true,
      "no_override": "",
      "bullet": "",
      "title_ko": "품질 보증 및 변경 관리",
      "title_en": "Quality Assurance and Change Control",
      "underline": true,
      "page_break_before": false,
      "note": "",
      "blocks": [
        {
          "indent": 1,
          "marker": "(1)",
          "ko": "무상 보증 기간은 납품 후 1년으로 한다.",
          "en": "The warranty period is one year after delivery."
        },
        {
          "indent": 1,
          "marker": "(2)",
          "ko": "보증 기간 중 제조자의 책임으로 발생한 고장은 무상으로 수리 또는 교환한다.",
          "en": "Failures attributable to the manufacturer within the warranty period are repaired or replaced free of charge."
        },
        {
          "indent": 1,
          "marker": "(3)",
          "ko": "성능·외관·보수에 영향을 주는 변경은 사전에 구매자에게 통지하고 승인을 받는다.",
          "en": "Any change affecting performance, appearance or maintenance shall be notified to the purchaser and approved in advance."
        },
        {
          "indent": 1,
          "marker": "(4)",
          "ko": "최신 리비전은 제품 명판에 표시하며, 본 사양서의 개정 이력은 표지에 기록한다.",
          "en": "The current revision is marked on the nameplate and recorded in the revision history on the cover of this specification."
        }
      ],
