    {
      "id": "dec92955",
      "key": "service",
      "audience": "customer",
      "kind": "spec_table",
      "numbered": true,
      "no_override": "",
      "bullet": "",
      "title_ko": "사용 조건",
      "title_en": "Service Conditions",
      "underline": true,
      "page_break_before": true,
      "note": "",
      "blocks": [],
      "rows": [
        {
          "item_ko": "1. Ambient temperature",
          "item_en": "",
          "spec": "Operation : -10 °C ~ +50 °C\nStorage : -20 °C ~ +60 °C",
          "remark": "",
          "audience": "both"
        },
        {
          "item_ko": "2. Altitude",
          "item_en": "",
          "spec": "1,000 m or less above sea level",
          "remark": "",
          "audience": "both"
        },
        {
          "item_ko": "3. Installation",
          "item_en": "",
          "spec": "Indoor use",
          "remark": "",
          "audience": "both"
        },
        {
          "item_ko": "4. Relative humidity",
          "item_en": "",
          "spec": "95 % or less, non-condensing",
          "remark": "",
          "audience": "both"
        },
        {
          "item_ko": "5. Cooling",
          "item_en": "",
          "spec": "Natural or forced air cooling\n(see rating table)",
          "remark": "",
          "audience": "both"
        },
        {
          "item_ko": "6. Ambient state",
          "item_en": "",
          "spec": "Free from excessive dust, corrosive gas,\nsalt and abnormal vibration",
          "remark": "",
          "audience": "both"
        }
      ],
