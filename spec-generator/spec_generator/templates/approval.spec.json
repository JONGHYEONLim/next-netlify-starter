  "sections": [
    {
      "id": "d37303f0",
      "key": "scope",
      "audience": "customer",
      "kind": "text",
      "numbered": true,
      "no_override": "",
      "bullet": "",
      "title_ko": "적용 범위",
      "title_en": "Scope",
      "underline": true,
      "page_break_before": false,
      "note": "",
      "blocks": [
        {
          "indent": 1,
          "marker": "",
          "ko": "본 사양서는 Braumm 이 공급하는 건식 리액터의 정격, 구조, 시험 및 검사에 대하여 규정한다. 대상 제품은 표지에 기재한 도면번호 및 형번의 제품으로 한다.",
          "en": "This specification covers the ratings, construction, testing and inspection of the dry-type reactor supplied by Braumm, identified by the drawing number and model shown on the cover."
        },
        {
          "indent": 1,
          "marker": "",
          "ko": "본 사양서에 규정하지 않은 사항은 아래 2항의 적용 규격 및 구매자가 승인한 도면에 따른다.",
          "en": "Items not specified herein shall conform to the applicable standards listed in Clause 2 and to the drawings approved by the purchaser."
        }
      ],
      "rows": [],
      "versions": [],
      "images": [],
      "part_no": "",
      "headers": [],
      "col_widths_mm": []
    },
