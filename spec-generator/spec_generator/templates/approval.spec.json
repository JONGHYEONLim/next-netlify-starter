    {
      "id": "9fd3ddf5",
      "key": "method",
      "audience": "customer",
      "kind": "spec_table",
      "numbered": true,
      "no_override": "",
      "bullet": "",
      "title_ko": "시험 방법",
      "title_en": "Test Methods",
      "underline": true,
      "page_break_before": false,
      "note": "",
      "blocks": [],
      "rows": [
        {
          "item_ko": "1. Inductance",
          "item_en": "",
          "spec": "Between coil terminals, LCR meter\n1 kHz unless otherwise specified",
          "remark": "",
          "audience": "both"
        },
        {
          "item_ko": "2. DC resistance",
          "item_en": "",
          "spec": "Micro-ohm meter, corrected to the\nreference temperature of the insulation class",
          "remark": "Class F/H : 115 °C",
          "audience": "both"
        },
        {
          "item_ko": "3. Insulation resistance",
          "item_en": "",
          "spec": "Coil to core (ground), DC 500 V megger",
          "remark": "",
          "audience": "both"
        },
        {
          "item_ko": "4. Dielectric withstand",
          "item_en": "",
          "spec": "Coil to core (ground), power frequency AC\nCut-off 10 mA",
          "remark": "Type : 60 s\nRoutine : 2 s",
          "audience": "both"
        },
        {
          "item_ko": "5. Temperature rise",
          "item_en": "",
          "spec": "Coil : resistance method\nCore : thermocouple method",
          "remark": "",
          "audience": "both"
        },
        {
          "item_ko": "6. Noise",
          "item_en": "",
          "spec": "1 m from the surface, A-weighted",
          "remark": "At rated current",
          "audience": "both"
        }
      ],
