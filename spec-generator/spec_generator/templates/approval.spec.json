    {
      "id": "438aede3",
      "key": "test",
      "audience": "customer",
      "kind": "text",
      "numbered": true,
      "no_override": "",
      "bullet": "",
      "title_ko": "시험 및 검사",
      "title_en": "Test and Inspection",
      "underline": true,
      "page_break_before": true,
      "note": "",
      "blocks": [
        {
          "indent": 1,
          "marker": "",
          "ko": "특별히 정하지 않는 한 모든 시험은 Braumm 공장에서 실시하며, 시험 성적서는 납품 시 함께 제출한다.",
          "en": "Unless otherwise agreed, all tests are carried out at the Braumm works and the test report is submitted with the delivery."
        },
        {
          "indent": 1,
          "marker": "(1)",
          "ko": "형식 시험 / Type test — 초도품 및 설계 변경 시",
          "en": ""
        },
        {
          "indent": 2,
          "marker": "①",
          "ko": "외관 및 치수 검사",
          "en": "Visual and dimensional inspection"
        },
        {
          "indent": 2,
          "marker": "②",
          "ko": "인덕턴스 측정",
          "en": "Measurement of inductance"
        },
        {
          "indent": 2,
          "marker": "③",
          "ko": "권선 직류 저항 측정",
          "en": "Measurement of winding DC resistance"
        },
        {
          "indent": 2,
          "marker": "④",
          "ko": "절연 저항 측정",
          "en": "Measurement of insulation resistance"
        },
        {
          "indent": 2,
          "marker": "⑤",
          "ko": "내전압 시험",
          "en": "Dielectric withstand voltage test"
        },
        {
          "indent": 2,
          "marker": "⑥",
          "ko": "온도 상승 시험",
          "en": "Temperature rise test"
        },
        {
          "indent": 2,
          "marker": "⑦",
          "ko": "포화 특성 확인",
          "en": "Saturation characteristic test"
        },
        {
          "indent": 2,
          "marker": "⑧",
          "ko": "소음 측정",
          "en": "Noise measurement"
        },
        {
          "indent": 1,
          "marker": "(2)",
          "ko": "전수 시험 / Routine test — 전 제품",
          "en": ""
        },
        {
          "indent": 2,
          "marker": "①",
          "ko": "외관 및 치수 검사",
          "en": "Visual and dimensional inspection"
        },
        {
          "indent": 2,
          "marker": "②",
          "ko": "인덕턴스 측정",
          "en": "Measurement of inductance"
        },
        {
          "indent": 2,
          "marker": "③",
          "ko": "권선 직류 저항 측정",
          "en": "Measurement of winding DC resistance"
        },
        {
          "indent": 2,
          "marker": "④",
          "ko": "절연 저항 측정",
          "en": "Measurement of insulation resistance"
        },
        {
          "indent": 2,
          "marker": "⑤",
          "ko": "내전압 시험",
          "en": "Dielectric withstand voltage test"
        }
      ],
